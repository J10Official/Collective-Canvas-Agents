{
  "name": "Single-team V1 four agent batch",
  "run_id_prefix": "drawing_single_v1_four_agent",
  "batch_scope": {
    "unit": "20 complete runs",
    "repetitions_per_configuration": 5,
    "stop_batch_after_cost_usd": 10.0
  },
  "conditions": [
    {
      "name": "homogeneous4_gemini",
      "members": [
        "Gemini",
        "Gemini",
        "Gemini",
        "Gemini"
      ]
    },
    {
      "name": "homogeneous4_qwen",
      "members": [
        "Qwen",
        "Qwen",
        "Qwen",
        "Qwen"
      ]
    },
    {
      "name": "homogeneous4_luna",
      "members": [
        "Luna",
        "Luna",
        "Luna",
        "Luna"
      ]
    },
    {
      "name": "homogeneous4_glm",
      "members": [
        "GLM",
        "GLM",
        "GLM",
        "GLM"
      ]
    }
  ],
  "models": {
    "GLM": {
      "model": "z-ai/glm-5.3-flash",
      "provider": "streamlake/fp8"
    },
    "Gemini": {
      "model": "google/gemini-3.8-flash",
      "provider": "google-ai-studio/flex"
    },
    "Qwen": {
      "model": "qwen/qwen3.8-27b",
      "provider": "reka/fp8"
    },
    "Luna": {
      "model": "openai/gpt-5.6-luna",
      "provider": "openai/flex"
    },
    "allow_provider_fallbacks": false
  },
  "task": {
    "object": "apple",
    "canvas_size": 32,
    "maximum_artwork_size": 16,
    "attach_reference_image": true,
    "initial_canvas": "blank",
    "placement": "unrestricted"
  },
  "protocol": {
    "prompt": "V1 optional forums",
    "team_forum": true,
    "public_forum": false,
    "personal_edit_history": true,
    "round_0_member_1_turn": true,
    "configured_rounds": 10,
    "maximum_pixels_per_turn": 8,
    "stop_when_every_member_returns_empty": true,
    "stop_when_stalled": true,
    "prompt_id": "forum_optional_v1"
  },
  "generation": {
    "reasoning": "low",
    "reasoning_budget": 1000,
    "temperature": 0.2,
    "maximum_output_tokens": 8192
  },
  "execution": {
    "runs_at_once": 20,
    "maximum_requests_per_provider": 1000,
    "agents_within_each_round": "parallel",
    "apply_responses": "completion_order",
    "configuration_order": "randomized",
    "randomization_seed": 20260912,
    "resume_interrupted_runs": true,
    "continue_batch_after_failed_run": true,
    "retry_policy": "existing_harness_policy"
  },
  "outputs": {
    "directory": "harness/batches/single_v1_four_agent",
    "save_every_snapshot": true,
    "save_final_png": true,
    "save_webm_video": false,
    "defer_video_generation": true,
    "video_frame_duration_seconds": 0.65,
    "save_prompts": true,
    "save_request_json": true,
    "save_input_images": true,
    "save_raw_responses": true,
    "save_parsed_actions": true,
    "save_usage_and_cost": true,
    "save_terminal_log": true,
    "request_image_logging": "separate_png"
  },
  "prompt_version": "V1"
}
